# ============================================================
#  dsh-win-tunnel · 服务器端配置
#  复制为 config.env 后修改:
#      cp config.example.env config.env
#      nano config.env
#  然后执行:  sudo bash install.sh
# ============================================================

# 对外域名。必须已经添加 A 记录解析到本机公网 IP,
# 否则 Let's Encrypt 签发会失败。
# 例: pc.example.com
DOMAIN=pc.example.com

# Let's Encrypt 到期通知邮箱(可以是任意有效邮箱)
EMAIL=you@example.com

# 隧道落点端口。PC 端 ssh -R 会把流量送到这里。
# 该端口只监听 127.0.0.1,不会暴露到公网。
# ★ 不要和本机已在用的端口冲突(例如本机 dsh web 的 13080)。
TUNNEL_PORT=13081

# 登录墙账号(nginx basic auth)。这是第一道门,DSH 自己的 token 是第二道。
AUTH_USER=dsh

# 登录墙密码。留空则自动生成一个随机强密码并打印出来。
AUTH_PASS=

# 允许上传的最大请求体(拖文件进浏览器时用)
CLIENT_MAX_BODY=50m

# 是否强制 HTTP 跳转 HTTPS(1=跳转,0=不跳)。公网访问请保持 1。
FORCE_HTTPS=1
